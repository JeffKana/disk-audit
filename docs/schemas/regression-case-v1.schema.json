{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JeffKana/disk-audit/docs/schemas/regression-case-v1.schema.json",
  "title": "disk-audit 判定回归样例 schema v1",
  "description": "依据：方案 9.1 底线二（任何真实误判当日转为测试用例）、开发规范 §3（判定类测试数据驱动，样例文件与测试分离；回归样例 JSON 一律脱敏）、调研报告 Roaming\\Code 误判 openaicodex 实证。待办 D6（任务卡 T2-04）。样例由 tests/test_regression_cases.py 自动加载：①本 schema 校验；②脱敏断言；③按样例输入驱动判定引擎并断言期望。格式说明见 docs/schemas/回归样例格式-v1.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "title",
    "registered_at",
    "registered_by",
    "root_cause",
    "path_pattern",
    "unit",
    "evidence_scenario",
    "expect"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^R[0-9]{3}$",
      "description": "样例编号（R+三位数字，递增不复用）"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "一句话说明该样例锁定的误判边界"
    },
    "registered_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "登记日期（底线二：真实误判当天入集）"
    },
    "registered_by": {
      "type": "string",
      "minLength": 1,
      "description": "登记来源（执行 Agent 任务卡号 / PM 复核记录等）"
    },
    "source_ref": {
      "type": "string",
      "description": "出处引用（方案节号 / 调研报告 / 原型修复位置）"
    },
    "root_cause": {
      "type": "string",
      "minLength": 1,
      "description": "误判根因（开发规范 §3：每例含根因）"
    },
    "path_pattern": {
      "type": "string",
      "minLength": 1,
      "description": "误判路径模式；用户名一律以 <user> 占位（脱敏）"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "dirs", "logical_bytes", "allocated_bytes", "max_mtime", "exe_files"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "dirs": {"type": "integer", "minimum": 0},
        "logical_bytes": {"type": "integer", "minimum": 0},
        "allocated_bytes": {"type": "integer", "minimum": 0},
        "max_mtime": {"type": "number", "minimum": 0, "description": "0 = 无 mtime 信息（不判陈旧）"},
        "exe_files": {"type": "integer", "minimum": 0}
      },
      "description": "判定单元聚合输入（与 scan 输出 units 元素同构，缺 path）"
    },
    "evidence_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uninstall", "appx", "processes", "services", "autostart"],
      "properties": {
        "uninstall": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["display_name", "publisher", "install_location", "install_date", "uninstall_string", "reg_path"],
            "properties": {
              "display_name": {"type": "string"},
              "publisher": {"type": "string"},
              "install_location": {"type": "string"},
              "install_date": {"type": "string"},
              "uninstall_string": {"type": "string", "description": "原文只采集不执行（U-4）"},
              "reg_path": {"type": "string"}
            }
          }
        },
        "appx": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "package_full_name", "install_location"],
            "properties": {
              "name": {"type": "string"},
              "package_full_name": {"type": "string"},
              "install_location": {"type": "string"}
            }
          }
        },
        "processes": {"type": "array", "items": {"type": "string"}},
        "services": {"type": "array", "items": {"type": "string"}},
        "autostart": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "name", "command", "kind"],
            "properties": {
              "source": {"type": "string"},
              "name": {"type": "string"},
              "command": {"type": "string"},
              "kind": {"enum": ["registry", "startup_folder"]}
            }
          }
        }
      },
      "description": "触发/复现该误判边界所需的证据场景（罐装，判定为纯函数）"
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "verdict_source"],
      "properties": {
        "confidence": {"enum": ["高", "中", "低", "受保护"]},
        "verdict_source": {"enum": ["硬保护", "知识库", "注册表", "进程服务", "Appx", "启发式"]},
        "forbidden_terms": {
          "type": "array",
          "items": {"type": "string"},
          "description": "判定输出全文不得出现的词（如被误判方的产品名）"
        }
      },
      "description": "期望判定（档位/来源，对应卡面'期望档位/期望来源'）"
    },
    "notes": {
      "type": "string",
      "description": "补充说明（期望来源的依据等）"
    }
  }
}
